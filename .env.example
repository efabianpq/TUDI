APP_NAME="TUDeficit Inteligente"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# CLAUDE.md sección 7: el "día" del usuario (cierre diario, promedios móviles,
# y la medianoche que dispara app:run-daily-closure) se calcula con esta
# timezone, nunca con UTC a pelo. El mercado objetivo es Colombia (GMT-5).
APP_TIMEZONE=America/Bogota

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tudeficit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CLAUDE.md sección 4.9: NutritionAiProviderInterface hoy solo tiene la
# implementación RuleBasedNutritionProvider (sin llamadas externas), así que
# no hay ninguna clave real que configurar todavía. Cuando exista un
# GenerativeAiProvider que sí llame a un proveedor externo, su API key va
# aquí — nunca hardcodeada ni commiteada (CLAUDE.md sección 10).
# AI_NUTRITION_PROVIDER_API_KEY=

# CLAUDE.md sección 4.12: clave de la API de OpenAI (ChatGPT). La usa
# OpenAiMealDistributionProvider, el proveedor vigente de
# MealDistributionProviderInterface, para convertir el texto libre de
# ingredientes de cada comida (y el consumo real del cierre) en una
# distribución de porciones y macronutrientes.
# Sin clave, "Generar distribución" muestra un error controlado y el resto de
# la aplicación sigue funcionando. Nunca commitear la clave real.
OPENAI_API_KEY=

# El modelo se cambia aquí, sin tocar código. `gpt-4.1` prioriza la precisión de
# las estimaciones; `gpt-4.1-mini` es la opción barata.
OPENAI_MODEL=gpt-4.1
OPENAI_ENDPOINT=https://api.openai.com/v1

# Estimación nutricional, no escritura creativa: temperatura al mínimo para que
# el mismo texto dé los mismos macros entre llamadas.
# OJO: con las familias de razonamiento (gpt-5, o3, o4) hay que poner
# OPENAI_TEMPERATURE=null — rechazan con un 400 cualquier valor distinto de 1.
OPENAI_TEMPERATURE=0.1

# Desviación máxima admitida entre los totales que suma PHP y los objetivos del
# día antes de pedirle al modelo que se corrija, y cuántas correcciones como
# mucho (0 lo desactiva). Cada corrección es otra llamada facturable y otro
# worker de PHP-FPM ocupado, de ahí el presupuesto total: no se empieza una
# corrección que no quepa entera por debajo de él.
OPENAI_TOLERANCIA_MACROS=0.05
OPENAI_REINTENTOS_MACROS=1
OPENAI_PRESUPUESTO_TOTAL=25

# Cuánto puede tardar una llamada al proveedor. NO es solo "cuánto espera el
# usuario": mientras dura, el proceso de PHP-FPM que la atiende no puede servir
# a nadie más, y con el pool pequeño de un hosting compartido unas pocas
# llamadas simultáneas agotan los workers y el resto de las peticiones caen en
# 504 (CLAUDE.md sección 4.22). Debe quedar POR DEBAJO del fastcgi_read_timeout
# del servidor (30-60 s en Hostinger), para que corte la aplicación —con un
# mensaje— y no el gateway.
OPENAI_TIMEOUT=20
OPENAI_CONNECT_TIMEOUT=5

# Modelo del plan B del dictado (CLAUDE.md sección 5.9), que está APAGADO por
# defecto: el camino normal es el reconocedor nativo del navegador, que no cuesta
# ninguna llamada. Endpoint distinto (audio/transcriptions) y modelo distinto.
OPENAI_MODEL_TRANSCRIPCION=gpt-4o-mini-transcribe

# Proveedores anteriores, conservados sin bindear por si hiciera falta volver
# atrás (CLAUDE.md sección 6). Vacíos no molestan a nadie.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT=20
GEMINI_CONNECT_TIMEOUT=5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
